# Stage 1: patch the bundle (localize.py), then unpack it into a static site
# (extract.py) so the browser never runs the self-extracting loader.
# Keep this COPY in step with the whitelist in .dockerignore.
FROM python:3.12-alpine AS localize
WORKDIR /build
COPY localize.py extract.py storage-shim.js firehome.html ./
RUN python localize.py firehome.html patched.html \
    && python extract.py patched.html dist

# Stage 2: static server. Nothing but nginx, the page and the icon set.
FROM nginx:1.27-alpine

LABEL org.opencontainers.image.title="firehome" \
      org.opencontainers.image.description="LAN-only self-hosted homepage"

# index.html plus assets/ — the fonts and JavaScript the loader used to decode
# from base64 on every page load.
COPY --from=localize /build/dist/ /usr/share/nginx/html/
# The full homarr-labs icon set, so the in-app icon picker resolves locally.
COPY svg/ /usr/share/nginx/html/icons/
# Generated by tools/make-favicon.py; favicon.ico is for clients that probe it
# blindly rather than reading the <link> tags.
COPY favicon.svg favicon.png favicon.ico apple-touch-icon.png /usr/share/nginx/html/
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
